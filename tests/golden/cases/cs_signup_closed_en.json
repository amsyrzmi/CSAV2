        "agents": [
          "subscription_agent"
        ],
        "gate": "send",
        "outbound_count": 1,
        "agent_errors": [],
        "escalations": 0,
        "reply_contains": [
          "isn't taking new sign-ups"
        ],
        "compose_sees": [
          "Plan Besar is not taking new sign-ups right now."
        ],
        "signup_requests": 0,
        "request_phone": false
      }
