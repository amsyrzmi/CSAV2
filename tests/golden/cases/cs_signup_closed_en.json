{
  "id": "cs_signup_closed_en",
  "matrix": "Sign-up: a plan closed to new sign-ups files nothing",
  "description": "Plan Besar is closed to new sign-ups: the reply says so at once, asks for no details and files nothing.",
  "seed": {
    "plans": [
      {
        "code": "kecil",
        "name": "Plan Kecil",
        "price": "15.00",
        "features": [
          "5GB data"
        ]
      },
      {
        "code": "besar",
        "name": "Plan Besar",
        "price": "50.00",
        "features": [
          "Unlimited data"
        ],
        "is_signup_open": false
      }
