{
  "id": "cs_signup_no_email_ask_telegram_en",
  "matrix": "Sign-up: Telegram never asks for an email, even with payments on",
  "description": "The company's payments are on and the contact has no email, but the chat is on Telegram: the sign-up is read back with no email question and no email in the read-back, and 'yes' right after it files one request that says an invoice follows approval.",
  "seed": {
    "plans": [
      {
        "code": "kecil",
        "name": "Plan Kecil",
        "price": "15.00",
        "features": [
          "5GB data"
        ]
      },
      {
        "code": "besar",
        "name": "Plan Besar",
        "price": "50.00",
        "features": [
          "Unlimited data"
        ]
      }
    ],
    "services": [
      "subscription_agent"
    ],
    "payments_enabled": true,
    "contact": {
      "phone": "0123456789",
      "phone_verified": true
    }
  },
  "turns": [
    {
      "say": "Sign me up for Plan Besar please, I'm Ali Bin Abu",
      "cassette": {
        "Classification": {
          "intent": "subscription",
          "language": "en",
          "sentiment": "neutral",
          "wants_human": false,
          "injection": false,
          "urgent": false,
          "needs": {
            "subscription_agent": 0.95
          }
        },
        "PlanOut": {
          "tasks": [
            {
              "agent": "subscription_agent",
              "input": {
                "action": "request_signup",
                "plan_code": "Plan Besar",
                "full_name": "Ali Bin Abu"
              }
            }
          ],
          "reply_strategy": "auto_reply"
        },
        "StepOut": {
          "done": true
        },
        "ComposeOut": {
          "reply": "Here's your sign-up: Plan Besar, name Ali Bin Abu, using the number already on this chat. Is that right? Reply yes to sign up. We keep your name and phone number on your contact record so the team can set up your plan."
        },
        "ReviewOut": {
          "ok": true
        }
      },
      "expect": {
        "route": "plan_args",
        "agents": [
          "subscription_agent"
        ],
        "gate": "send",
        "outbound_count": 1,
        "agent_errors": [],
        "escalations": 0,
        "reply_contains": [
          "Is that right?"
        ],
        "reply_excludes": [
          "email"
        ],
        "compose_sees": [
          "Sign-up for Plan Besar: name Ali Bin Abu, phone the number already on this chat. Is that right? Reply yes to sign up. Nothing is filed until you do."
        ],
        "model_never_sees": [
          "payment reminders by email",
          "That email address does not look right",
          ", no email."
        ],
        "signup_requests": 0,
        "request_phone": false
      }
    },
    {
      "say": "yes",
      "cassette": {
        "Classification": {
          "intent": "subscription",
          "language": "en",
          "sentiment": "neutral",
          "wants_human": false,
          "injection": false,
          "urgent": false,
          "needs": {
            "subscription_agent": 0.9
          }
        },
        "PlanOut": {
          "tasks": [
            {
              "agent": "subscription_agent",
              "input": {
                "action": "request_signup",
                "plan_code": "Plan Besar",
                "full_name": "Ali Bin Abu",
                "confirmed": true
              }
            }
          ],
          "reply_strategy": "auto_reply"
        },
        "StepOut": {
          "done": true
        },
        "ComposeOut": {
          "reply": "Thanks! Your sign-up for Plan Besar was received. The team will review it; once it is approved you'll get an invoice with how to pay, and the plan starts when the payment is confirmed. Nothing is active yet."
        },
        "ReviewOut": {
          "ok": true
        }
      },
      "expect": {
        "route": "plan_args",
        "agents": [
          "subscription_agent"
        ],
        "gate": "send",
        "outbound_count": 1,
        "agent_errors": [],
        "escalations": 0,
        "reply_contains": [
          "received"
        ],
        "compose_sees": [
          "Your sign-up for Plan Besar was received. The team will review it; once it is approved you'll get an invoice with how to pay, and the plan starts when the payment is confirmed. Nothing is active yet."
        ],
        "model_never_sees": [
          "payment reminders by email",
          ", no email."
        ],
        "signup_requests": 1
      }
    }
  ]
}
