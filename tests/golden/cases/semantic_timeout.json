{
  "id": "semantic_timeout",
  "matrix": "Resilience: semantic checker timeout",
  "description": "A checker failure degrades to the deterministic grounding check for the turn (design G5): the grounded draft is sent, with no fail-safe and no escalation.",
  "turns": [{
    "say": "where is my order",
    "cassette": {
      "Classification": {"intent": "order", "language": "en", "sentiment": "neutral", "wants_human": false, "injection": false, "urgent": false, "needs": {"order_agent": 0.95}},
      "StepOut": {"done": true},
      "ComposeOut": {"reply": "No active orders were found for you."},
      "ReviewOut": {"error": "groq_timeout"}
    },
    "expect": {
      "route": "plan_args", "agents": [], "gate": "send", "outbound_count": 1,
      "reply_contains": ["No active orders were found for you."], "reply_excludes": ["team member"],
      "llm_calls": {"ComposeOut": 1, "ReviewOut": 1}, "escalations": 0
    }
  }]
}
