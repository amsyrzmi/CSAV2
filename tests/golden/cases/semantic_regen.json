    "expect": {
      "route": "plan_args", "agents": ["order_agent"], "gate": "send", "outbound_count": 1,
      "reply_contains": ["MYR 10.50"], "reply_excludes": ["free delivery"],
      "compose_sees": ["Free delivery is not supported by the facts."],
      "llm_calls": {"ComposeOut": 2, "ReviewOut": 2}, "escalations": 0
    }
  }]
