{
  "id": "flow_clarify_twice_escalates",
  "matrix": "Flow: clarify twice escalates to human support",
  "description": "A second clarifying turn escalates to staff instead of endlessly asking clarifying questions.",
  "turns": [
    {
      "say": "something ambiguous",
      "cassette": {
        "Classification": {"intent": "other", "language": "en", "sentiment": "neutral", "wants_human": false, "injection": false, "urgent": false, "needs": {}},
        "PlanOut": {"tasks": [], "reply_strategy": "ask_clarifying"},
        "StepOut": {"done": true},
        "ComposeOut": {"reply": "Could you please specify how I can help you today?"},
        "ReviewOut": {"ok": true}
      },
      "expect": {
        "route": "clarify", "agents": [], "gate": "send",
        "outbound_count": 1, "reply_contains": ["Could you please specify"],
        "escalations": 0
      }
    },
    {
      "say": "still unclear",
      "cassette": {
        "Classification": {"intent": "other", "language": "en", "sentiment": "neutral", "wants_human": false, "injection": false, "urgent": false, "needs": {}},
        "PlanOut": {"tasks": [], "reply_strategy": "ask_clarifying"},
        "HandoffOut": {"reply": "I've passed this to a team member who will get back to you shortly.", "staff_note": "The customer's message was unclear twice, so the assistant could not tell what they need. Nothing was answered.", "gap_topic": null}
      },
      "expect": {
        "route": "clarify", "agents": ["escalation_agent"], "gate": "send",
        "outbound_count": 1, "reply_contains": ["team member"],
        "llm_not_called": ["ReviewOut"],
        "escalations": 1
      }
    }
  ]
}
