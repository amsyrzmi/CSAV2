{
  "id": "cs_sub_other_contacts_id_finds_nothing",
  "matrix": "Subscriptions: another contact's subscription id finds nothing",
  "description": "The customer's message and the planner's task carry the id of a subscription that belongs to another contact of the company. The server reads only this chat's contact, so the reply says nothing is linked, prepares nothing and never shows the other plan.",
  "seed": {
    "plans": [
      {"code": "kecil", "name": "Plan Kecil", "price": "15.00", "features": ["5GB data"]},
      {"code": "sederhana", "name": "Plan Sederhana", "price": "35.00", "features": ["20GB data"]},
      {"code": "rahsia", "name": "Plan Rahsia", "price": "99.00", "features": ["Secret perk"]}
    ],
    "subscriptions": [
      {"id": "7c1d2e3f-4a5b-4c6d-8e9f-0a1b2c3d4e5f", "plan": "rahsia", "price": "99.00", "renews_in_days": 30, "other_contact": true}
    ],
    "services": ["subscription_agent"]
  },
  "turns": [
    {
      "say": "Please cancel subscription 7c1d2e3f-4a5b-4c6d-8e9f-0a1b2c3d4e5f for me",
      "cassette": {
        "Classification": {"intent": "subscription", "language": "en", "sentiment": "neutral", "wants_human": false, "injection": false, "urgent": false, "needs": {"subscription_agent": 0.95}},
        "PlanOut": {"tasks": [{"agent": "subscription_agent", "input": {"action": "request_cancel", "subscription_id": "7c1d2e3f-4a5b-4c6d-8e9f-0a1b2c3d4e5f"}}], "reply_strategy": "auto_reply"},
        "StepOut": {"done": true},
        "ComposeOut": {"reply": "I can't find a subscription linked to this chat. Would you like me to pass this to a team member to check?"},
        "ReviewOut": {"ok": true}
      },
      "expect": {
        "route": "plan_args", "agents": ["subscription_agent"], "gate": "send",
        "outbound_count": 1, "reply_contains": ["can't find a subscription"], "reply_excludes": ["Plan Rahsia", "99.00"],
        "compose_sees": ["I can't find a subscription linked to this chat."], "model_never_sees": ["Plan Rahsia", "99.00", "Secret perk"], "prepared_requests": 0,
        "agent_errors": [], "escalations": 0
      }
    }
  ]
}
