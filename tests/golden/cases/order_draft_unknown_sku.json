      "PlanOut": {"tasks": [{"agent": "order_agent", "input": {"action": "create_draft", "items": [{"sku": "UNKNOWN_SKU", "qty": 1}]}}], "reply_strategy": "auto_reply"},
      "StepOut": {"done": true},
      "ComposeOut": {"reply": "Sorry, UNKNOWN_SKU is not found in our catalogue."},
      "ReviewOut": {"ok": true}
