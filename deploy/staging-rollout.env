# Non-secret staging switches for scripts/staging_rollout.py.
# One KEY=value per line; blank lines and # comments are ignored.
# Exactly these eight keys, all required; changing one is a reviewed PR.
# GATEWAY_MODEL_SECRET names a secret; it never holds a secret value.
CSA_STAGING_CONSOLE_ORIGIN=https://staging-console.fourstacks.my
CSA_STAGING_HOOKS_ORIGIN=https://hooks.fourstacks.my
CSA_STAGING_WORKSPACE_ASSISTANT=true
CSA_STAGING_GATEWAY_MODEL_SECRET=staging_model_key
CSA_STAGING_INVITE_MAIL=true
CSA_STAGING_EMAIL_ASSISTANT=true
# Bookings and Google Calendar. Both stay false until the Calendar API, the calendar.app.created
# scope and the callback address are set up in Google (deploy/STAGING_PIPELINE.md, Google Calendar);
# turning one on is its own reviewed PR. Meet needs the calendar.
CSA_STAGING_BOOKINGS_GOOGLE_CALENDAR=false
CSA_STAGING_BOOKINGS_GOOGLE_MEET=false
