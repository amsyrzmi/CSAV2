# Non-secret staging switches for scripts/staging_rollout.py.
# One KEY=value per line; blank lines and # comments are ignored.
# Exactly these eight keys, all required; changing one is a reviewed PR.
# GATEWAY_MODEL_SECRET names a secret; it never holds a secret value.
CSA_STAGING_CONSOLE_ORIGIN=https://staging-console.fourstacks.my
CSA_STAGING_HOOKS_ORIGIN=https://hooks.fourstacks.my
CSA_STAGING_WORKSPACE_ASSISTANT=true
CSA_STAGING_GATEWAY_MODEL_SECRET=staging_model_key
CSA_STAGING_INVITE_MAIL=true
CSA_STAGING_EMAIL_ASSISTANT=true
# Bookings and Google Calendar. Calendar is on: the Calendar API, the calendar.app.created scope and
# the callback address are set up in Google (deploy/STAGING_PIPELINE.md, section 13). Meet is on too
# (an online booking with no link asks Google for a room); it needs the calendar. If Google refuses
# Meet on the Bookings calendar, set it back to false: nothing else is affected.
CSA_STAGING_BOOKINGS_GOOGLE_CALENDAR=true
CSA_STAGING_BOOKINGS_GOOGLE_MEET=true
# Video in the training library. On: the training worker transcribes with the speech endpoint and
# staging keeps videos on its own volume (docs/RUNBOOK.md, "Training video", "Staging disk").
CSA_STAGING_TRAINING_VIDEO=true
# Jev (docs/RUNBOOK.md, 'Jev for the staff assistant and the customer classifier'): the real key file
# pipeline/staging_jev_key is mounted as TYPESAFE_API_KEY on the gateway and the worker. The staff
# assistant areas then run in cascade (Jev decides at or above the 0.7 floors, anything else falls back
# to the LLM); the customer classifier stays on the LLM until its own gate passes (runbook step 4).
# Evaluation on 2026-11-17: every staff question met its target at the default floors.
CSA_STAGING_JEV_SECRET=staging_jev_key
