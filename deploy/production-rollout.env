# Non-secret production switches for scripts/staging_rollout.py --target production.
# One KEY=value per line; blank lines and # comments are ignored.
# Exactly these six keys, all required; changing one is a reviewed PR.
# GATEWAY_MODEL_SECRET names a secret; it never holds a secret value.
# The console and hooks origins and the backup bucket and region are not here (this repository
# is public): they live in /srv/csa-prod/host.env on the instance, with any CSA_PROD_* sizing
# override and CSA_PROD_DB_IMAGE.
# These values mirror what production runs today: the first scripted deploy changes no setting.
# Turning an assistant or Bookings switch on for production later is a reviewed PR here.
CSA_STAGING_WORKSPACE_ASSISTANT=false
CSA_STAGING_GATEWAY_MODEL_SECRET=staging_disabled_model_key
CSA_STAGING_INVITE_MAIL=true
CSA_STAGING_EMAIL_ASSISTANT=true
CSA_STAGING_BOOKINGS_GOOGLE_CALENDAR=false
CSA_STAGING_BOOKINGS_GOOGLE_MEET=false
