{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendTheDeployDocumentToTheProductionInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:<region>:<account-id>:document/csa-production-deploy",
        "arn:aws:ssm:<region>:<account-id>:managed-instance/<managed-instance-id>"
      ]
    },
    {
      "Sid": "ReadCommandResults",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    }
  ]
}
