# Copy to .env.local for the isolated dev stack only. Never put production secrets here.
# On the server the dev stack must not touch production csa_db, csa-net, or the
# production gateway on 127.0.0.1:8080 (dev gateway uses DEV_GATEWAY_PORT).
DEV_PGPORT=5433
DEV_GATEWAY_PORT=18080
# Current application settings are consumed by csa/core/settings.py.
ENV=dev
# Local disposable Postgres only (make up / make db-reset).
DATABASE_URL=postgresql://csa_app:dev_app_pw@127.0.0.1:5433/csa
LG_DATABASE_URL=postgresql://csa_app:dev_app_pw@127.0.0.1:5433/csa
CSA_OWNER_PASSWORD=dev_owner_pw
CSA_APP_PASSWORD=dev_app_pw
CSA_RO_PASSWORD=dev_ro_pw

# AI providers. Use development keys; Jev is optional until LG06 integration.
GROQ_API_KEY=replace-with-your-development-groq-key
GROQ_MODEL=openai/gpt-oss-120b
# Optional independent composer failover (Gemini API); the decision and planning
# calls stay on Groq. Enter a development key locally to enable fallback replies.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
# Optional (dev only): Telegram chat id of the staff/support group, seeded by make setup-dev-telegram.
DEV_STAFF_CHAT_ID=
# Optional: enables the read-only /console/v1 API for the web-console backend (min 32 chars).
CONSOLE_API_TOKEN=
TYPESAFE_API_KEY=
# Reserved for future provider integrations; not read by the current application.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Required by current settings for encrypting channel credentials at rest.
# Generate 32 random bytes with `openssl rand -base64 32`, then put its output
# after the `base64:` prefix. Use a different key for every environment.
CREDENTIALS_KEY=base64:replace-with-base64-of-32-random-bytes

# Current application/runtime settings.
# Public HTTPS hostname that Caddy/Cloudflare routes to the dev gateway
# (a dedicated dev hostname, never a production one).
PUBLIC_BASE_URL=https://dev-csa.example.com
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set to polling only for the isolated local dev bot; this removes its webhook
# while retaining pending updates. Webhook mode is the normal deployment mode.
# echo = LG03 echo path; coordinator = LG04 graph (placeholder deciders until LG06/LG07)
TURN_ENGINE=echo
CHANNEL_MODE=webhook
CHECKPOINT_RETENTION_DAYS=14

# Telegram: create a separate development bot. Use these values only to
# bootstrap its credential into the local database with
# `make setup-dev-telegram`; normal ingress reads the encrypted DB credential.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Meta app-level configuration for the WhatsApp Cloud API integration.
# Use only a dev app in this local file; per-customer access tokens and phone
# number IDs are encrypted in channel_credentials, not stored here.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=

# Google OAuth app configuration shared by Gmail/Calendar integrations.
# User/mailbox/calendar refresh tokens are per-connection encrypted
# credentials, not committed or shared.
# gmail.readonly and gmail.compose are restricted; compose also allows
# sending, so adapter policy must keep live sending disabled until approved.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://dev-csa.example.com/oauth/google/callback
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
GOOGLE_PUBSUB_PUSH_AUDIENCE=
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=
# Optional host path only; keep any service-account key outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Optional service endpoints for future adapters; verify names when implemented.
MCP_SERVER_URL=http://127.0.0.1:8001
VOICE_GATEWAY_URL=http://127.0.0.1:8082

# Knowledge base: TEI embeddings (384-dim) and console upload ingestion.
# Without TEI_ENDPOINT, dev/ci use a lexical hash embedder; prod requires TEI.
TEI_ENDPOINT=http://127.0.0.1:8081
KB_EMBED_MODEL_LABEL=tei-384
TEI_QUERY_PREFIX="query: "
TEI_PASSAGE_PREFIX="passage: "
KB_INGEST_ENABLED=false
KB_UPLOAD_ROOT=
KB_MAX_FILES_PER_JOB=3
KB_MAX_FILE_BYTES=10485760
KB_INGEST_POLL_SECONDS=10

# LG13 marketplace and invoices (secrets: set only in .env.local / server secrets).
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
INVOICE_SIGNING_SECRET=

# Optional observability integrations (not required for local tests).
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
